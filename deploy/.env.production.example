# Cấu hình production (máy chủ chạy self-hosted runner). Chép thành deploy/.env.production (đã gitignore),
# điền giá trị rồi chạy:  bash deploy/sync-secrets.sh
#
# Container app chạy trong docker network local-services (cùng network với container postgres và minio),
# nên gọi thẳng theo tên container: postgres:5432, minio:9000.
# Tài khoản riêng của app: role Postgres "inventory" (chủ DB inventory), user MinIO "inventory-app"
# (policy inventory-rw, chỉ đọc/ghi inventory-bucket).

# ---- Secret ----
DATABASE_URL=postgres://inventory:${DB_PASSWORD}@postgres:5432/inventory
MINIO_ACCESS_KEY=inventory-app
MINIO_SECRET_KEY=
GOOGLE_CLIENT_SECRET=
# Tuỳ chọn: thông báo sắp hết hàng
TELEGRAM_BOT_TOKEN=
SMTP_PASS=
# Tuỳ chọn: trợ lý chat (LLM tự host)
LLM_API_KEY=

# ---- Variable ----
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=inventory-bucket
GOOGLE_CLIENT_ID=
# Tên miền public (Cloudflare Tunnel → http://localhost:3040). Thêm
#   <APP_BASE_URL>/api/auth/google/callback  vào Authorized redirect URIs trên Google Console.
APP_BASE_URL=https://kho.example.com
COOKIE_SECURE=true
MAX_UPLOAD_MB=500
# Tuỳ chọn: email (SMTP_PASS để ở phần secret phía trên)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_FROM=
# Tuỳ chọn: trợ lý chat — server LLM API kiểu OpenAI (bỏ trống = tắt), tên model (bỏ trống = model đầu tiên)
LLM_BASE_URL=
LLM_MODEL=

# Cổng trên máy (chỉ bind 127.0.0.1) và giới hạn tài nguyên container
APP_PORT=3040
APP_MEM_LIMIT=768m
APP_CPU_LIMIT=1.5
DOCKER_NETWORK=local-services
