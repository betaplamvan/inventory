# ---- PostgreSQL ----
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
POSTGRES_PORT=5433
DATABASE_URL=postgres://inventory:inventory@localhost:5433/inventory

# ---- MinIO (lưu ảnh / video / datasheet) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=inventory

# ---- Đăng nhập bằng Google (OAuth) ----
# Tạo OAuth Client (loại "Web application") tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Địa chỉ mà trình duyệt dùng để mở app (dùng để tạo redirect URI)
APP_BASE_URL=http://localhost:3000
# Đặt true khi chạy sau HTTPS
COOKIE_SECURE=false
# Cho phép "đăng nhập thử" không qua Google (CHỈ dùng khi dev, không bao giờ bật ở production)
ALLOW_DEV_LOGIN=false

# Dung lượng tối đa mỗi file upload (MB)
MAX_UPLOAD_MB=500

# ---- Thông báo sắp hết hàng (tuỳ chọn, bỏ trống = tắt kênh đó) ----
# Telegram: tạo bot bằng @BotFather, dán token vào đây. Mỗi người tự kết nối ở trang Tài khoản.
TELEGRAM_BOT_TOKEN=
# Email qua SMTP. Ví dụ Gmail: smtp.gmail.com, cổng 465, SMTP_PASS là "App password" (không phải mật khẩu Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Địa chỉ người gửi, ví dụ: Kho linh kiện <kho@example.com> (mặc định = SMTP_USER)
SMTP_FROM=

# ---- Trợ lý chat (tuỳ chọn) ----
# Server LLM có API kiểu OpenAI (llama.cpp server, vLLM, Ollama…), có hoặc không có /v1. Bỏ trống = tắt trợ lý.
LLM_BASE_URL=
LLM_API_KEY=
# Tên model; bỏ trống = model đầu tiên của /v1/models
LLM_MODEL=
